{
  "galleryDir": "src/dev/gallery",
  "srcDir": "src",
  "surfaceRoots": [
    "src/modules",
    "src/components/ui"
  ],
  "kitImport": "@ziee/kit",
  "$overlayKitImports": [
    "The package default is ['@/components/ui', '@/modules/layouts/app-layout/components/Drawer'].",
    "Desktop surfaces import overlay primitives straight from the kit PACKAGE",
    "specifier instead (e.g. ConversationMountsControl's Popover), so '@ziee/kit'",
    "is appended here. Without it the overlay gate silently reports 0 hosts and",
    "passes — the one active behaviour the deleted desktop fork carried, now",
    "expressed as config rather than a second implementation.",
    "NOTE the sibling 'kitImport' key above is read by nothing; see CLAUDE.md's",
    "follow-up list."
  ],
  "overlayKitImports": [
    "@/components/ui",
    "@/modules/layouts/app-layout/components/Drawer",
    "@ziee/kit"
  ],
  "portWhich": "desktopGallery",
  "galleryUrl": "/gallery.html",
  "extraTrees": [
    "../../ui/src"
  ],
  "kitTestIds": [
    "../../../sdk/packages/kit/src",
    "../../../sdk/packages/shell/src"
  ],
  "testidOut": "../../../sdk/packages/kit/src/testIds.generated.ts",
  "harnessCopies": "../../../gallery-harness-copies.json",
  "runtimeBaselineModule": "src/dev/gallery/runtime-baseline.js",
  "visualConfig": null,
  "gateExtraCmds": [
    [
      "coverage",
      "npm",
      [
        "run",
        "check:gallery-coverage"
      ]
    ]
  ]
}
