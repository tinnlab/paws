{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ziee",
  "mainBinaryName": "ziee",
  "version": "0.1.0",
  "identifier": "com.ziee.chat",
  "build": {
    "beforeDevCommand": "npm run dev --workspace=@ziee/desktop-ui",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build --workspace=@ziee/ui-core && npm run build --workspace=@ziee/desktop-ui",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {}
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://tinnlab.github.io/paws/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU4QkI5QUQyRDY4MzZCRjcKUldUM2E0UFcwcHE3V0p6cnYwMHhQZ2RoWk9UY1pKNU1MMW9yckpBZm1tTmlyWVJ2S0pBYlh6RUIK"
    }
  }
}
