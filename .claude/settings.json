{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/agent-kit/lifecycle/edit-lint-hook.mjs\" 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "lint (edited file)"
          }
        ]
      }
    ]
  }
}
