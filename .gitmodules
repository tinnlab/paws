[submodule "src-app/server/vendor/pgvector"]
	path = src-app/server/vendor/pgvector
	url = https://github.com/pgvector/pgvector.git
	branch = master
[submodule "sdk"]
	path = sdk
	url = https://github.com/ziee-ai/sdk.git
	# ziee (the "chat" app) pins the SDK to its dedicated branch `chat`
	# (CytoAnalyst pins `cyto`). The agent-core + frontend-perf integration has
	# LANDED and its SDK line was reconciled back here: `chat` was fast-forwarded
	# onto `sdk/agent-core-and-perf`, so the two are identical and this pin is
	# back on the canonical branch.
	branch = chat
[submodule "agent-kit"]
	path = agent-kit
	url = https://github.com/ziee-ai/agent-kit.git
