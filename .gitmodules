[submodule "src-app/server/vendor/pgvector"]
	path = src-app/server/vendor/pgvector
	url = https://github.com/pgvector/pgvector.git
	branch = master
[submodule "sdk"]
	path = sdk
	url = https://github.com/ziee-ai/sdk.git
	# paws pins the SDK to its own dedicated branch `paws` (ziee/"chat" pins
	# `chat`, CytoAnalyst pins `cyto`) — one branch per consuming app, so an
	# app-driven regen of a generated kit artifact does not land on another
	# app's line.
	#
	# `paws` was cut from `chat` at 584756d + this repo's testId-registry regens.
	# It therefore starts 2 commits BEHIND `chat` (4ab7530): those two touch only
	# `crates/ziee-sandbox` and were deliberately not absorbed, so the pointer
	# stays exactly the tree the default-model-onboarding branch was verified
	# against. Merge `chat` into `paws` when those sandbox changes are wanted —
	# as a deliberate step, with the consuming build re-run.
	branch = paws
[submodule "agent-kit"]
	path = agent-kit
	url = https://github.com/ziee-ai/agent-kit.git
